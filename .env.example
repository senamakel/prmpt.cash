# prmpt plugin -- environment configuration.
#
# Every value here can also live in ~/.config/prmpt/config.json. Environment
# always wins over the file.

# User JWT, obtained by signing in with the locally held wallet. Without it the hook does
# nothing. Treat it like a password: it identifies the wallet that gets paid, it
# is valid for 30 days, and NOTHING can revoke it before then.
PRMPT_TOKEN=

# Backend GraphQL endpoint. Default: https://api.prmpt.cash/graphql
PRMPT_ENDPOINT=https://api.prmpt.cash/graphql

# Set to 1 to switch off ad serving completely. The hook exits immediately,
# makes no network call, and prints nothing.
PRMPT_DISABLED=

# Hard deadline for the serveAd request, in milliseconds. Default: 1500.
# The hook abandons the request at this point and stays silent.
PRMPT_TIMEOUT_MS=1500

# How the sponsored block is emitted. Default: auto.
#   auto  a TTY gets styled text; a pipe gets the JSON {"systemMessage": ...}
#         envelope that Claude Code surfaces to the user
#   text  always plain/styled text on stdout
#   json  always the JSON envelope
PRMPT_OUTPUT=auto

# Standard: any non-empty value suppresses ANSI styling.
NO_COLOR=

# --- the status-line surface (Claude Code only) -----------------------------
#
# A second place an ad can appear: one segment appended to the footer that
# renders while the model is working. The decision is fetched by a detached
# child on UserPromptSubmit and rendered from a file, so nothing on the render
# path ever touches the network.
#
# PRMPT_DISABLED=1 switches this off along with everything else, and leaves
# your own status-line command running untouched.

# Deadline for the background fetch, in milliseconds. Default: 15000.
# Deliberately far longer than PRMPT_TIMEOUT_MS: nothing is waiting on this, so
# it can afford the 5-15s a genuinely cold serve costs.
PRMPT_SLOT_TIMEOUT_MS=15000

# How long the status line waits for the command it wrapped -- the one you had
# before installing -- before using whatever that command produced so far.
# Milliseconds. Default: 2000.
PRMPT_STATUSLINE_WRAP_MS=2000

# Terminal width, if your host exports it. When set, the ad segment is clipped
# so the whole line fits, and is dropped entirely rather than squeezing out the
# status line you already had.
COLUMNS=
