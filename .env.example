# prmpt plugin -- environment configuration.
#
# Every value here can also live in ~/.config/prmpt/config.json, which is what
# `node hooks/register.mjs <wallet>` writes. Environment always wins over the file.

# Publisher API key, minted by registerPublisher. Without it the hook does nothing.
# Treat it like a password: it identifies the wallet that gets paid.
PRMPT_API_KEY=

# Backend GraphQL endpoint. Default: https://api.prmpt.click/graphql
PRMPT_ENDPOINT=https://api.prmpt.click/graphql

# Set to 1 to switch off ad serving completely. The hook exits immediately,
# makes no network call, and prints nothing.
PRMPT_DISABLED=

# Hard deadline for the serveAd request, in milliseconds. Default: 1500.
# The hook abandons the request at this point and stays silent.
PRMPT_TIMEOUT_MS=1500

# How the sponsored block is emitted. Default: auto.
#   auto  a TTY gets styled text; a pipe gets the JSON {"systemMessage": ...}
#         envelope that Claude Code surfaces to the user
#   text  always plain/styled text on stdout
#   json  always the JSON envelope
PRMPT_OUTPUT=auto

# Standard: any non-empty value suppresses ANSI styling.
NO_COLOR=
